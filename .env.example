# Lumakara Store — Environment Variables Template
# Copy to .env and fill in your actual values.
# NEVER commit .env, .env.local, or .env.server to version control.

# ============================================================
# FRONTEND (Vite — safe to expose in browser bundle)
# ============================================================

# Supabase (get from https://supabase.com/dashboard/project/_/settings/api)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudflare Turnstile SITE KEY only (not secret key — site key is public)
# Get from https://dash.cloudflare.com → Turnstile
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# EmailJS (public key is safe to expose)
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# ============================================================
# SERVER-SIDE ONLY (Supabase Edge Function secrets)
# Set via: supabase secrets set KEY=value
# NEVER prefix server secrets with VITE_
# ============================================================

# Supabase service role (server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare Turnstile SECRET key (server-side only — never expose to frontend)
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# Payment providers
NEOXR_API_KEY=your-neoxr-api-key
SAWERIA_USER_ID=your-saweria-user-id
RAMA_API_KEY=your-rama-api-key
RAMA_BASE_URL=https://ramashop.my.id/api/public

# Webhook secret (generate with: openssl rand -hex 32)
PAYMENT_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
