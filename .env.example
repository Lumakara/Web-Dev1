# Frontend-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# Server-only values. Configure these with `supabase secrets set`, never Vite.
NEOXR_API_KEY=your-neoxr-api-key
SAWERIA_USER_ID=your-saweria-user-id
MUSTIKA_API_KEY=your-mustika-api-key
MUSTIKA_BASE_URL=https://mustikapayment.com
RAMA_API_KEY=your-rama-api-key
RAMA_BASE_URL=https://ramashop.my.id/api/public
PAYMENT_WEBHOOK_SECRET=generate-a-long-random-value
